# Copy this file to .env and fill in real values.

# Elastic Observability / Synthetics (Project Monitors)
# Use your Observability project / Kibana URL and an API key with Synthetics writer/editor privileges.
# The same key can be used via SYNTHETICS_API_KEY env or --auth flag.
ELASTIC_CLOUD_ID="your-cloud-id"
ELASTIC_KIBANA_URL="https://your-kibana-url"   # e.g. https://o11y-project-01-xxxx.kb.ap-southeast-1.aws.elastic.cloud
ELASTIC_API_KEY="your-api-key"
SYNTHETICS_API_KEY="your-api-key"

ELASTIC_SYNTHETICS_SPACE_ID="default"
ELASTIC_SYNTHETICS_PROJECT_ID="web-journeys"
ELASTIC_SYNTHETICS_LOCATION="us_east"   # Elastic managed location ID — run GET /api/synthetics/private_locations to list yours

# Jina Reader / Search (for automated journey research)
# See: https://jina.ai/reader/
JINA_API_KEY="your-jina-api-key"
